---
// src/pages/index.astro
//
// 独立首页：不复用 Starlight 默认的顶部导航栏 / 侧边栏 / 右侧目录。
// 用 <StarlightPage template="splash"> 是关键 —— 它会让 Starlight 自动把
// hasSidebar / tableOfContents 都设为 false（源码 utils/routing/data.ts 第
// 54、65 行：`hasSidebar: entry.data.template !== 'splash'`，splash 模板下
// toc 也强制为 false），所以左侧栏、右侧目录不会被渲染，不需要我们自己再隐藏。
// 但顶部的 <header class="header">（Logo / 搜索 / 主题切换）在任何模板下都会
// 无条件渲染（见 Page.astro），所以下方 <style is:global> 里手动把它隐藏掉，
// 换成我们自己做的、更适合首页的浮动品牌条。
//
// 仍然复用主题自带的 Card / CardGrid / Badge / LinkCard 组件——它们已经在
// md3.components 层里做好了 token 化样式，不需要重新写卡片/徽标的 CSS。
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Card, CardGrid, LinkCard } from '@astrojs/starlight/components';
import { Image } from 'astro:assets';
import dev_1 from '../assets/main-page/dev-1.jpg';
import dev_2 from '../assets/main-page/dev-2.jpg';
